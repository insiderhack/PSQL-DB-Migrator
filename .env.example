# PostgreSQL Migration Tool - Environment Configuration

# Source Database (PostgreSQL 14, 15, 16, or 17)
SOURCE_DB_HOST=localhost
SOURCE_DB_PORT=5432
SOURCE_DB_NAME=mydb
SOURCE_DB_USER=postgres
SOURCE_DB_PASSWORD=your_password_here

# Target Database (PostgreSQL 18)
TARGET_DB_HOST=localhost
TARGET_DB_PORT=5433
TARGET_DB_NAME=mydb
TARGET_DB_USER=postgres
TARGET_DB_PASSWORD=your_password_here

# PostgreSQL Binary Paths (optional - auto-detected if not set)
# PG_BIN_PATH=/usr/lib/postgresql/18/bin
# PG_UPGRADE_PATH=/usr/lib/postgresql/18/bin/pg_upgrade

# Migration Options
MIGRATION_PARALLEL_JOBS=4
MIGRATION_PRESERVE_STATS=true
MIGRATION_USE_SWAP=true

# Logging
LOG_LEVEL=INFO
LOG_FILE=migration.log
